@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui: <http://lv2plug.in/ns/extensions/ui#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<https://sephonix.com/plugins/sps-echo> a lv2:Plugin, lv2:DelayPlugin, doap:Project ;
    doap:name "SPS Echo" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    doap:maintainer [ foaf:name "Sephonix" ; foaf:homepage <https://github.com/Sephonix/sps-dsp> ] ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ;
    lv2:optionalFeature lv2:hardRTCapable, urid:map ;
    ui:ui <https://sephonix.com/plugins/sps-echo#ui> ;
    lv2:port
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Input Left" ],
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Input Right" ],
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Output Left" ],
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Output Right" ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:default 35 ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:portProperty lv2:connectionOptional ; units:unit units:pc ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "output" ; lv2:name "Output" ; lv2:default 0 ; lv2:minimum -24 ; lv2:maximum 24 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "bypass" ; lv2:name "Bypass" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional ; lv2:portProperty lv2:integer, lv2:toggled ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "time" ; lv2:name "Delay" ; lv2:default 250 ; lv2:minimum 0.01 ; lv2:maximum 1000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:ms ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "sync" ; lv2:name "Sync" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 3 ; lv2:portProperty lv2:connectionOptional ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:scalePoint [ rdfs:label "Free" ; rdf:value 0 ], [ rdfs:label "Straight" ; rdf:value 1 ], [ rdfs:label "Dotted" ; rdf:value 2 ], [ rdfs:label "Triplet" ; rdf:value 3 ] ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 9 ; lv2:symbol "division" ; lv2:name "Note" ; lv2:default 4 ; lv2:minimum 0 ; lv2:maximum 11 ; lv2:portProperty lv2:connectionOptional ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:scalePoint [ rdfs:label "1/64" ; rdf:value 0 ], [ rdfs:label "1/32" ; rdf:value 1 ], [ rdfs:label "1/16" ; rdf:value 2 ], [ rdfs:label "1/8" ; rdf:value 3 ], [ rdfs:label "1/4" ; rdf:value 4 ], [ rdfs:label "1/2" ; rdf:value 5 ], [ rdfs:label "1 bar" ; rdf:value 6 ], [ rdfs:label "2 bars" ; rdf:value 7 ], [ rdfs:label "4 bars" ; rdf:value 8 ], [ rdfs:label "8 bars" ; rdf:value 9 ], [ rdfs:label "16 bars" ; rdf:value 10 ], [ rdfs:label "32 bars" ; rdf:value 11 ] ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 10 ; lv2:symbol "shift" ; lv2:name "Frequency Shift" ; lv2:default 0 ; lv2:minimum -1000 ; lv2:maximum 1000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:hz ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 11 ; lv2:symbol "feedback" ; lv2:name "Feedback" ; lv2:default 40 ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:portProperty lv2:connectionOptional ; units:unit units:pc ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 12 ; lv2:symbol "low_cut" ; lv2:name "Low Cut" ; lv2:default 20 ; lv2:minimum 0 ; lv2:maximum 2000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:hz ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 13 ; lv2:symbol "high_cut" ; lv2:name "High Cut" ; lv2:default 12000 ; lv2:minimum 200 ; lv2:maximum 20000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:hz ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 14 ; lv2:symbol "stereo" ; lv2:name "Stereo Shift" ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:scalePoint [ rdfs:label "Mono shift" ; rdf:value 0 ], [ rdfs:label "Opposing stereo" ; rdf:value 1 ] ],
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 15 ; lv2:symbol "meter_0" ; lv2:name "Input" ; lv2:minimum -120 ; lv2:maximum 60 ; units:unit units:db ; lv2:portProperty lv2:connectionOptional ],
    [ a lv2:ControlPort, lv2:OutputPort ; lv2:index 16 ; lv2:symbol "meter_1" ; lv2:name "Output" ; lv2:minimum -120 ; lv2:maximum 60 ; units:unit units:db ; lv2:portProperty lv2:connectionOptional ],
    [ a atom:AtomPort, lv2:InputPort ; lv2:index 17 ; lv2:symbol "transport" ; lv2:name "Tempo transport" ; atom:bufferType atom:Sequence ; atom:supports time:Position ; lv2:portProperty lv2:connectionOptional ] .

<https://sephonix.com/plugins/sps-echo#ui> a ui:X11UI ; ui:binary <sps_echo.so> ;
    lv2:requiredFeature ui:parent, ui:idleInterface ;
    lv2:optionalFeature ui:resize ;
    lv2:extensionData ui:idleInterface ;
    ui:portNotification
    [ ui:plugin <https://sephonix.com/plugins/sps-echo> ; ui:portIndex 15 ; ui:protocol ui:floatProtocol ],
    [ ui:plugin <https://sephonix.com/plugins/sps-echo> ; ui:portIndex 16 ; ui:protocol ui:floatProtocol ] .
