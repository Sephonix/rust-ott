@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui: <http://lv2plug.in/ns/extensions/ui#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<https://sephonix.com/plugins/sps-room#factory> a pset:Preset ; lv2:appliesTo <https://sephonix.com/plugins/sps-room> ;
    rdfs:label "SPS Room — Default" ;
    lv2:port
    [ lv2:symbol "mix" ; pset:value 35 ],
    [ lv2:symbol "output" ; pset:value 0 ],
    [ lv2:symbol "bypass" ; pset:value 0 ],
    [ lv2:symbol "mode" ; pset:value 0 ],
    [ lv2:symbol "predelay" ; pset:value 15 ],
    [ lv2:symbol "decay" ; pset:value 2 ],
    [ lv2:symbol "high_cut" ; pset:value 12000 ],
    [ lv2:symbol "low_cut" ; pset:value 0 ],
    [ lv2:symbol "depth" ; pset:value 70 ],
    [ lv2:symbol "early_size" ; pset:value 45 ],
    [ lv2:symbol "early_cross" ; pset:value 30 ],
    [ lv2:symbol "early_rate" ; pset:value 0.4 ],
    [ lv2:symbol "early_mod" ; pset:value 10 ],
    [ lv2:symbol "early_send" ; pset:value 60 ],
    [ lv2:symbol "diffusion" ; pset:value 85 ],
    [ lv2:symbol "space" ; pset:value 0 ],
    [ lv2:symbol "late_size" ; pset:value 50 ],
    [ lv2:symbol "late_cross" ; pset:value 60 ],
    [ lv2:symbol "late_rate" ; pset:value 0.5 ],
    [ lv2:symbol "late_mod" ; pset:value 15 ],
    [ lv2:symbol "bass_mult" ; pset:value 1.2 ],
    [ lv2:symbol "bass_xover" ; pset:value 600 ],
    [ lv2:symbol "high_mult" ; pset:value 0.5 ],
    [ lv2:symbol "high_xover" ; pset:value 6000 ] .
