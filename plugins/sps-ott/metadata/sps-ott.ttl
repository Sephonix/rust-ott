@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui: <http://lv2plug.in/ns/extensions/ui#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

<https://sephonix.com/plugins/sps-ott> a lv2:Plugin, lv2:CompressorPlugin, doap:Project ;
    doap:name "SPS OTT" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    doap:maintainer [ foaf:name "Sephonix" ; foaf:homepage <https://github.com/Sephonix/sps-dsp> ] ;
    lv2:minorVersion 0 ; lv2:microVersion 1 ;
    lv2:optionalFeature lv2:hardRTCapable ;
    ui:ui <https://sephonix.com/plugins/sps-ott#ui> ;
    lv2:port
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "Input Left" ],
    [ a lv2:AudioPort, lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "Input Right" ],
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Output Left" ],
    [ a lv2:AudioPort, lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Output Right" ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 4 ; lv2:symbol "amount" ; lv2:name "Amount" ; lv2:default 100 ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:portProperty lv2:connectionOptional ; units:unit units:pc ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 5 ; lv2:symbol "output" ; lv2:name "Output" ; lv2:default 0 ; lv2:minimum -36 ; lv2:maximum 18 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 6 ; lv2:symbol "mix" ; lv2:name "Mix" ; lv2:default 100 ; lv2:minimum 0 ; lv2:maximum 100 ; lv2:portProperty lv2:connectionOptional ; units:unit units:pc ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 7 ; lv2:symbol "lo_x" ; lv2:name "Low / Mid" ; lv2:default 88.3 ; lv2:minimum 20 ; lv2:maximum 1000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:hz ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 8 ; lv2:symbol "hi_x" ; lv2:name "Mid / High" ; lv2:default 2500 ; lv2:minimum 1000 ; lv2:maximum 18000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:hz ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 9 ; lv2:symbol "detect" ; lv2:name "Detection" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional ; lv2:portProperty lv2:integer, lv2:enumeration ; lv2:scalePoint [ rdfs:label "RMS" ; rdf:value 0 ], [ rdfs:label "Peak" ; rdf:value 1 ] ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 10 ; lv2:symbol "knee" ; lv2:name "Soft knee" ; lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional ; lv2:portProperty lv2:integer, lv2:toggled ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 11 ; lv2:symbol "bypass" ; lv2:name "Bypass" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional ; lv2:portProperty lv2:integer, lv2:toggled ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 12 ; lv2:symbol "l_atk" ; lv2:name "Low Attack" ; lv2:default 47.8 ; lv2:minimum 0.1 ; lv2:maximum 200 ; lv2:portProperty lv2:connectionOptional ; units:unit units:ms ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 13 ; lv2:symbol "l_rel" ; lv2:name "Low Release" ; lv2:default 282 ; lv2:minimum 5 ; lv2:maximum 2000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:ms ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 14 ; lv2:symbol "l_dt" ; lv2:name "Low Down threshold" ; lv2:default -33.8 ; lv2:minimum -72 ; lv2:maximum 0 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 15 ; lv2:symbol "l_dr" ; lv2:name "Low Down ratio" ; lv2:default 66.7 ; lv2:minimum 1 ; lv2:maximum 1000 ; lv2:portProperty lv2:connectionOptional ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 16 ; lv2:symbol "l_ut" ; lv2:name "Low Up threshold" ; lv2:default -40.8 ; lv2:minimum -72 ; lv2:maximum 0 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 17 ; lv2:symbol "l_ur" ; lv2:name "Low Up ratio" ; lv2:default 4.17 ; lv2:minimum 1 ; lv2:maximum 20 ; lv2:portProperty lv2:connectionOptional ],
