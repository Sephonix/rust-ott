    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 38 ; lv2:symbol "h_in" ; lv2:name "High Input" ; lv2:default 5.2 ; lv2:minimum -24 ; lv2:maximum 24 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 39 ; lv2:symbol "h_out" ; lv2:name "High Output" ; lv2:default 10.3 ; lv2:minimum -24 ; lv2:maximum 24 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
