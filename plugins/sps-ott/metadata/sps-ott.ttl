    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 19 ; lv2:symbol "l_out" ; lv2:name "Low Output" ; lv2:default 10.3 ; lv2:minimum -24 ; lv2:maximum 24 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 20 ; lv2:symbol "l_mute" ; lv2:name "Low Mute" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional ; lv2:portProperty lv2:integer, lv2:toggled ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 21 ; lv2:symbol "l_solo" ; lv2:name "Low Solo" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional ; lv2:portProperty lv2:integer, lv2:toggled ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 22 ; lv2:symbol "m_atk" ; lv2:name "Mid Attack" ; lv2:default 22.4 ; lv2:minimum 0.1 ; lv2:maximum 200 ; lv2:portProperty lv2:connectionOptional ; units:unit units:ms ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 23 ; lv2:symbol "m_rel" ; lv2:name "Mid Release" ; lv2:default 282 ; lv2:minimum 5 ; lv2:maximum 2000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:ms ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 24 ; lv2:symbol "m_dt" ; lv2:name "Mid Down threshold" ; lv2:default -30.3 ; lv2:minimum -72 ; lv2:maximum 0 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 25 ; lv2:symbol "m_dr" ; lv2:name "Mid Down ratio" ; lv2:default 66.7 ; lv2:minimum 1 ; lv2:maximum 1000 ; lv2:portProperty lv2:connectionOptional ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 26 ; lv2:symbol "m_ut" ; lv2:name "Mid Up threshold" ; lv2:default -41.8 ; lv2:minimum -72 ; lv2:maximum 0 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 27 ; lv2:symbol "m_ur" ; lv2:name "Mid Up ratio" ; lv2:default 4.17 ; lv2:minimum 1 ; lv2:maximum 20 ; lv2:portProperty lv2:connectionOptional ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 28 ; lv2:symbol "m_in" ; lv2:name "Mid Input" ; lv2:default 5.2 ; lv2:minimum -24 ; lv2:maximum 24 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 29 ; lv2:symbol "m_out" ; lv2:name "Mid Output" ; lv2:default 5.7 ; lv2:minimum -24 ; lv2:maximum 24 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 30 ; lv2:symbol "m_mute" ; lv2:name "Mid Mute" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional ; lv2:portProperty lv2:integer, lv2:toggled ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 31 ; lv2:symbol "m_solo" ; lv2:name "Mid Solo" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:connectionOptional ; lv2:portProperty lv2:integer, lv2:toggled ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 32 ; lv2:symbol "h_atk" ; lv2:name "High Attack" ; lv2:default 13.5 ; lv2:minimum 0.1 ; lv2:maximum 200 ; lv2:portProperty lv2:connectionOptional ; units:unit units:ms ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 33 ; lv2:symbol "h_rel" ; lv2:name "High Release" ; lv2:default 132 ; lv2:minimum 5 ; lv2:maximum 2000 ; lv2:portProperty lv2:connectionOptional ; units:unit units:ms ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 34 ; lv2:symbol "h_dt" ; lv2:name "High Down threshold" ; lv2:default -35.5 ; lv2:minimum -72 ; lv2:maximum 0 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 35 ; lv2:symbol "h_dr" ; lv2:name "High Down ratio" ; lv2:default 1000 ; lv2:minimum 1 ; lv2:maximum 1000 ; lv2:portProperty lv2:connectionOptional ],
    [ a lv2:ControlPort, lv2:InputPort ; lv2:index 36 ; lv2:symbol "h_ut" ; lv2:name "High Up threshold" ; lv2:default -40.8 ; lv2:minimum -72 ; lv2:maximum 0 ; lv2:portProperty lv2:connectionOptional ; units:unit units:db ],
